# The port your Express API will listen on
PORT=3000

# For local development with docker-compose up db (without API/Client), use:
# DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/tda26
#
# For local development with docker-compose up (all services), use:
# DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/tda26
#
# For Tour de Cloud deployment, use:
# DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/tda26
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/tda26
# Secret for server-side sessions
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"
JWT_SECRET="CHANGE_ME_JWT_SECRET"
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ORG_DEFAULT_PASSWORD=CHANGE_ME_ORG_DEFAULT_PASSWORD
