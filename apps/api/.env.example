# The port your Express API will listen on
PORT=3000

# For local development with docker-compose up db (without API/Client), use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tda26
#
# For local development with docker-compose up (all services), use:
# DATABASE_URL=postgresql://postgres:password@db:5432/tda26
#
# For Tour de Cloud deployment, use:
# DATABASE_URL=postgresql://postgres:password@db:5432/tda26
DATABASE_URL=postgresql://postgres:password@db:5432/tda26
# Secret for server-side sessions
SESSION_SECRET="your-secret-key-change-in-production"
JWT_SECRET="your-jwt-secret-change-in-production"
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-me
ORG_DEFAULT_PASSWORD=TdA26!
